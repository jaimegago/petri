---
# HorizontalPodAutoscaler: {{ .AppName }}
# Lab: {{ .Lab.Name }} | Company: {{ .Company.Name }}
# Generated by Petri (Level {{ .Level.Number }}+)
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ .AppName }}
  namespace: {{ .Namespace }}
  labels:
    app: {{ .AppName }}
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    managed-by: petri
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ .AppName }}
  minReplicas: {{ .Replicas }}
  maxReplicas: {{ mul .Replicas 3 }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 80
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
        - type: Percent
          value: 10
          periodSeconds: 60
    scaleUp:
      stabilizationWindowSeconds: 60
      policies:
        - type: Percent
          value: 50
          periodSeconds: 60
