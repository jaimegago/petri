---
# Ingress: {{ .AppName }}
# Lab: {{ .Lab.Name }} | Company: {{ .Company.Name }}
# Generated by Petri
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ .AppName }}
  namespace: {{ .Namespace }}
  labels:
    app: {{ .AppName }}
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    managed-by: petri
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
{{- if eq (print .Lab.LabType) "local" }}
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
{{- else }}
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    cert-manager.io/cluster-issuer: letsencrypt-prod
{{- end }}
spec:
  ingressClassName: nginx
{{- if ne (print .Lab.LabType) "local" }}
  tls:
    - hosts:
        - {{ .AppName }}.{{ .Lab.Name }}.{{ .Company.Name }}.internal
      secretName: {{ .AppName }}-tls
{{- end }}
  rules:
{{- if eq (print .Lab.LabType) "local" }}
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ .AppName }}
                port:
                  number: 80
{{- else }}
    - host: {{ .AppName }}.{{ .Lab.Name }}.{{ .Company.Name }}.internal
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ .AppName }}
                port:
                  number: 80
{{- end }}
