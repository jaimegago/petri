---
# PodDisruptionBudget: {{ .AppName }}
# Lab: {{ .Lab.Name }} | Company: {{ .Company.Name }}
# Generated by Petri (Level {{ .Level.Number }}+)
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{ .AppName }}
  namespace: {{ .Namespace }}
  labels:
    app: {{ .AppName }}
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    managed-by: petri
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: {{ .AppName }}
