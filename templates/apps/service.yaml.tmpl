---
# Service: {{ .AppName }}
# Lab: {{ .Lab.Name }} | Company: {{ .Company.Name }}
# Generated by Petri
apiVersion: v1
kind: Service
metadata:
  name: {{ .AppName }}
  namespace: {{ .Namespace }}
  labels:
    app: {{ .AppName }}
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    managed-by: petri
spec:
  selector:
    app: {{ .AppName }}
  ports:
    - name: http
      port: 80
      targetPort: {{ .Port }}
      protocol: TCP
  type: ClusterIP
---
# ServiceAccount: {{ .AppName }}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ .AppName }}
  namespace: {{ .Namespace }}
  labels:
    app: {{ .AppName }}
    lab: "{{ .Lab.Name }}"
    managed-by: petri
