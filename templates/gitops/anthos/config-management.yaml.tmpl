---
# Anthos Config Management for {{ .Company.Name }} lab {{ .Lab.Name }}
# Generated by Petri on {{ .Now.Format "2006-01-02" }}
apiVersion: configmanagement.gke.io/v1
kind: ConfigManagement
metadata:
  name: config-management
  labels:
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    managed-by: petri
spec:
  clusterName: {{ .Company.Name }}-{{ index .Level.ClusterNames 0 }}-{{ .Lab.Name }}
  git:
    syncRepo: https://github.com/{{ .Company.GitHubOrg }}/{{ .Company.Name }}-lab-{{ .Lab.ID }}-gitops.git
    syncBranch: main
    policyDir: clusters/{{ index .Level.ClusterNames 0 }}
    secretType: none
  sourceFormat: hierarchy
---
apiVersion: configsync.gke.io/v1beta1
kind: RootSync
metadata:
  name: root-sync
  namespace: config-management-system
  labels:
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    managed-by: petri
spec:
  sourceFormat: hierarchy
  git:
    repo: https://github.com/{{ .Company.GitHubOrg }}/{{ .Company.Name }}-lab-{{ .Lab.ID }}-gitops.git
    branch: main
    dir: clusters/{{ index .Level.ClusterNames 0 }}
    auth: none
