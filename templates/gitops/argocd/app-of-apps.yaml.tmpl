---
# App-of-Apps root Application for {{ .Company.Name }} lab {{ .Lab.Name }}
# Generated by Petri on {{ .Now.Format "2006-01-02" }}
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ .Company.Name }}-{{ .Lab.Name }}-apps
  namespace: argocd
  labels:
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    managed-by: petri
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/{{ .Company.GitHubOrg }}/{{ .Company.Name }}-lab-{{ .Lab.ID }}-gitops.git
    targetRevision: HEAD
    path: clusters/{{ index .Level.ClusterNames 0 }}/applications
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
