---
# ArgoCD Application: {{ .AppName }}
# Lab: {{ .Lab.Name }} | Company: {{ .Company.Name }}
# Generated by Petri
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ .AppName }}
  namespace: argocd
  labels:
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    app: "{{ .AppName }}"
    managed-by: petri
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/{{ .Company.GitHubOrg }}/{{ .Company.Name }}-lab-{{ .Lab.ID }}-gitops.git
    targetRevision: HEAD
    path: apps/{{ .AppName }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ .Namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 3
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 1m
