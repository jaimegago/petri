---
# Flux GitRepository + Kustomization for {{ .Company.Name }} lab {{ .Lab.Name }}
# Generated by Petri on {{ .Now.Format "2006-01-02" }}
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: {{ .Company.Name }}-{{ .Lab.Name }}-gitops
  namespace: flux-system
  labels:
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    managed-by: petri
spec:
  interval: 1m0s
  ref:
    branch: main
  url: https://github.com/{{ .Company.GitHubOrg }}/{{ .Company.Name }}-lab-{{ .Lab.ID }}-gitops.git
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: {{ .Company.Name }}-{{ .Lab.Name }}-apps
  namespace: flux-system
  labels:
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    managed-by: petri
spec:
  interval: 10m0s
  path: ./clusters/{{ index .Level.ClusterNames 0 }}/apps
  prune: true
  sourceRef:
    kind: GitRepository
    name: {{ .Company.Name }}-{{ .Lab.Name }}-gitops
  timeout: 5m0s
  retryInterval: 2m0s
