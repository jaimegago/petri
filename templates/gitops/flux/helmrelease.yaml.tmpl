---
# Flux HelmRelease: {{ .AppName }}
# Lab: {{ .Lab.Name }} | Company: {{ .Company.Name }}
# Generated by Petri
apiVersion: helm.toolkit.fluxcd.io/v2beta2
kind: HelmRelease
metadata:
  name: {{ .AppName }}
  namespace: {{ .Namespace }}
  labels:
    lab: "{{ .Lab.Name }}"
    company: "{{ .Company.Name }}"
    app: "{{ .AppName }}"
    managed-by: petri
spec:
  interval: 10m
  chart:
    spec:
      chart: {{ .AppName }}
      version: ">=0.1.0"
      sourceRef:
        kind: HelmRepository
        name: {{ .Company.Name }}-charts
        namespace: flux-system
  values:
    replicaCount: {{ .Replicas }}
    image:
      repository: {{ .ImageRepository }}
      tag: latest
    service:
      type: ClusterIP
      port: {{ .Port }}
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi
