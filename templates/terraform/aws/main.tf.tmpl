locals {
  prefix = "{{ .Company.Name }}-{{ .Lab.Name }}"
}

# ─── VPC ─────────────────────────────────────────────────────────────────────

module "vpc" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "~> 5.0"

  name = local.prefix
  cidr = "10.0.0.0/16"

  azs             = ["${var.aws_region}a", "${var.aws_region}b", "${var.aws_region}c"]
  private_subnets = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
  public_subnets  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

  enable_nat_gateway   = true
  single_nat_gateway   = {{ if levelGte .Level.Number 2 }}false{{ else }}true{{ end }}
  enable_dns_hostnames = true
  enable_dns_support   = true

  public_subnet_tags = {
    "kubernetes.io/role/elb" = 1
  }

  private_subnet_tags = {
    "kubernetes.io/role/internal-elb" = 1
  }
}
{{ range $i, $cluster := .Level.ClusterNames }}
# ─── EKS: {{ $cluster }} ──────────────────────────────────────────────────────

module "eks_{{ $cluster }}" {
  source  = "terraform-aws-modules/eks/aws"
  version = "~> 20.0"

  cluster_name    = "${local.prefix}-{{ $cluster }}"
  cluster_version = var.kubernetes_version

  vpc_id                         = module.vpc.vpc_id
  subnet_ids                     = module.vpc.private_subnets
  cluster_endpoint_public_access = true

  eks_managed_node_groups = {
    main = {
      min_size       = 1
      max_size       = {{ add (index $.Level.NodeCounts $i) 2 }}
      desired_size   = var.{{ $cluster }}_node_count
      instance_types = ["{{ index $.Level.InstanceTypes $i }}"]

      labels = {
        Environment = "{{ $cluster }}"
        ManagedBy   = "petri"
      }
    }
  }

  tags = {
    Environment = "{{ $cluster }}"
  }
}
{{ end }}
{{ range .Level.Databases }}
{{ if eq .Type "postgresql" }}
# ─── RDS PostgreSQL ───────────────────────────────────────────────────────────

module "rds" {
  source  = "terraform-aws-modules/rds/aws"
  version = "~> 6.0"

  identifier        = "${local.prefix}-pg"
  engine            = "postgres"
  engine_version    = "{{ .EngineVersion }}"
  instance_class    = "{{ .InstanceClass }}"
  allocated_storage = 20

  db_name  = "{{ $.Company.Name }}db"
  username = "petri_admin"
  port     = "5432"

  vpc_security_group_ids = [module.vpc.default_security_group_id]
  db_subnet_group_name   = module.vpc.database_subnet_group_name

  family               = "postgres{{ .EngineVersion }}"
  major_engine_version = "{{ .EngineVersion }}"

  deletion_protection = false
}
{{ end }}
{{ if eq .Type "redis" }}
# ─── ElastiCache Redis ────────────────────────────────────────────────────────

resource "aws_elasticache_subnet_group" "redis" {
  name       = "${local.prefix}-redis-subnet"
  subnet_ids = module.vpc.private_subnets
}

resource "aws_elasticache_cluster" "redis" {
  cluster_id           = "${local.prefix}-redis"
  engine               = "redis"
  node_type            = "{{ .NodeType }}"
  num_cache_nodes      = 1
  parameter_group_name = "default.redis{{ .EngineVersion }}"
  engine_version       = "{{ .EngineVersion }}"
  port                 = 6379
  subnet_group_name    = aws_elasticache_subnet_group.redis.name
}
{{ end }}
{{ end }}
