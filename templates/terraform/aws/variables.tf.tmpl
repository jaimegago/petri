variable "aws_region" {
  description = "AWS region for resource deployment"
  type        = string
  default     = "us-east-1"
}

variable "lab_name" {
  description = "Unique lab identifier used in resource naming"
  type        = string
  default     = "{{ .Lab.Name }}"
}

variable "company" {
  description = "Company name used in resource tagging"
  type        = string
  default     = "{{ .Company.Name }}"
}

variable "level" {
  description = "Infrastructure complexity level (1-3)"
  type        = number
  default     = {{ .Level.Number }}
}

variable "kubernetes_version" {
  description = "Target Kubernetes version for EKS clusters"
  type        = string
  default     = "1.29"
}
{{ range $i, $cluster := .Level.ClusterNames }}
variable "{{ $cluster }}_node_count" {
  description = "Desired node count for the {{ $cluster }} cluster"
  type        = number
  default     = {{ index $.Level.NodeCounts $i }}
}
{{ end }}
